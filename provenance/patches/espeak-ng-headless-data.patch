+    /**
+     * Installs the embedded data without starting an Activity. TTS services
+     * are often created from a background process, where Android blocks an
+     * Activity launch. This keeps first use fully offline and headless.
+     */
+    public static boolean installBaseResources(Context context) {
+        final File output = getDataPath(context).getParentFile();
+        FileUtils.rmdir(getDataPath(context));
+
+        try (InputStream stream = context.getResources().openRawResource(R.raw.espeakdata);
+             ZipInputStream zipStream = new ZipInputStream(new BufferedInputStream(stream))) {
+            byte[] buffer = new byte[10240];
+            ZipEntry entry;
+            while ((entry = zipStream.getNextEntry()) != null) {
+                File destination = new File(output, entry.getName());
+                String outputPath = output.getCanonicalPath();
+                String destinationPath = destination.getCanonicalPath();
+                if (!destinationPath.equals(outputPath)
+                        && !destinationPath.startsWith(outputPath + File.separator)) {
+                    throw new IOException("Unsafe eSpeak data path: " + entry.getName());
+                }
+                if (entry.isDirectory()) {
+                    if (!destination.mkdirs() && !destination.isDirectory()) {
+                        throw new IOException("Unable to create " + destination);
+                    }
+                    continue;
+                }
+                File parent = destination.getParentFile();
+                if (!parent.exists() && !parent.mkdirs()) {
+                    throw new IOException("Unable to create " + parent);
+                }
+                try (FileOutputStream outputStream = new FileOutputStream(destination)) {
+                    int bytesRead;
+                    while ((bytesRead = zipStream.read(buffer)) != -1) {
+                        outputStream.write(buffer, 0, bytesRead);
+                    }
+                }
+                zipStream.closeEntry();
+            }
+
+            String version = FileUtils.read(
+                    context.getResources().openRawResource(R.raw.espeakdata_version));
+            FileUtils.write(new File(getDataPath(context), "version"), version);
+            return true;
+        } catch (Exception exception) {
+            Log.e(TAG, "Unable to install embedded eSpeak data", exception);
+            return false;
+        }
+    }
+
